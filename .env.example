# ── Required ───────────────────────────────────────────────────────────────

# Password to access the app — change this to something strong!
APP_PASSWORD=my-secret-password-here

# ── Chat (Groq — free tier) ────────────────────────────────────────────────
# Sign up FREE at: https://console.groq.com
# No credit card required. Generous free limits (500k tokens/day).
GROQ_API_KEY=gsk_...

# Optional: change the model (default: llama-3.3-70b-versatile)
# Other free options: llama3-8b-8192, mixtral-8x7b-32768, gemma2-9b-it
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Images (Pollinations.ai — 100% FREE, no key needed!) ──────────────────
# Nothing to configure — images work out of the box!

# ── Video (HuggingFace — free tier) ───────────────────────────────────────
# Sign up FREE at: https://huggingface.co → Settings → Access Tokens → New Token
# Select "Read" role — that's all you need.
HF_TOKEN=hf_...
