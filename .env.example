# ── Required ───────────────────────────────────────────────────────────────

# Your Anthropic API key (for Claude chat)
# Get it at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Password to access the app (change this to something strong!)
APP_PASSWORD=my-secret-password-here

# ── Image Generation ───────────────────────────────────────────────────────

# Together.ai API key (for FLUX image generation)
# Get it at: https://api.together.xyz — free tier available
TOGETHER_API_KEY=...

# ── Video Generation ───────────────────────────────────────────────────────

# fal.ai API key (for Kling video generation)
# Get it at: https://fal.ai
FAL_API_KEY=...
